{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}" }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true,
          "outputTemplate": "[{Application}][{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithProcessId", "WithMachineName" ]
  },
  "ConnectionStrings": {
    "Main": "Server=.;Database=MABO_GAMES_DATABASE;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;Encrypt=true"
  },

  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Market.Api",
    "Audience": "Market.Spa",
    "Key": "DEV_ONLY_CHANGE_ME_TO_LONG_RANDOM_SECRET",
    "AccessTokenMinutes": 20,
    "RefreshTokenDays": 14
  },

  "Email": {
    "Host": "sandbox.smtp.mailtrap.io",
    "Port": 2525,
    "Username": "REDACTED_MAILTRAP_USERNAME",
    "Password": "REDACTED_MAILTRAP_PASSWORD",
    "From": "noreply@mabogames.local"
  },

  "ImageBB": {
    "ApiKey": "REDACTED_IMAGEBB_APIKEY"
  },

  "IGDB": {
    "ClientID": "REDACTED_IGDB_CLIENT_ID",
    "ClientSecret": "REDACTED_IGDB_CLIENT_SECRET",
    "BaseUrl": "https://api.igdb.com/v4",
    "TokenUrl": "https://id.twitch.tv/oauth2/token"
  },
  "Recaptcha": {
    "SecretKey": "REDACTED_RECAPTCHA_SECRET",
    "VerifyUrl": "https://www.google.com/recaptcha/api/siteverify"
  },

  "Supabase": {
    "ServiceRoleSecret": "REDACTED_SUPABASE_SERVICE_ROLE_KEY",
    "BaseUrl": "https://boacdgczsgsmpjlvplug.supabase.co",
    "BucketName": "Games"
  },



  "Stripe": {
    "SecretKey": "", //replace
    "WebhookSecret": "", //replace
    "SuccessUrl": "http://localhost:4200/public/payment/success?session_id={CHECKOUT_SESSION_ID}",
    "CancelUrl": "http://localhost:4200/public/checkout"

  }

}